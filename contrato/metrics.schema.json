{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metrics.schema.json",
  "title": "metrics.json: índice que carga el visor al abrir (ADR-010)",
  "description": "Catálogo de cuerpos, variables, marcas, perfiles, sitios y archivos de resultados. Campos desconocidos se ignoran: el visor no debe fallar si llegan campos nuevos.",
  "type": "object",
  "required": ["version_contrato", "generado", "es_ejemplo", "healpix", "cuerpos", "variables", "marcas", "perfiles", "sitios_objetivo", "analogos_conocidos", "resultados", "fuentes"],
  "properties": {
    "version_contrato": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$", "description": "Semver. Mientras empiece por 1. el visor no cambia." },
    "generado": { "type": "string", "description": "Fecha y hora ISO 8601 en UTC." },
    "es_ejemplo": { "type": "boolean", "description": "true: datos inventados para construir el visor. No mostrarlos como resultados." },
    "healpix": { "$ref": "#/$defs/healpix" },
    "cuerpos": {
      "type": "object",
      "required": ["tierra", "luna", "marte"],
      "additionalProperties": { "$ref": "#/$defs/cuerpo" }
    },
    "variables": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/variable" } },
    "marcas": { "type": "array", "items": { "$ref": "#/$defs/marca" } },
    "perfiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/perfil" } },
    "sitios_objetivo": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sitio_objetivo" } },
    "analogos_conocidos": { "type": "array", "items": { "$ref": "#/$defs/analogo_conocido" } },
    "resultados": { "type": "array", "items": { "$ref": "#/$defs/resultado_resumen" } },
    "fuentes": { "type": "array", "items": { "$ref": "#/$defs/fuente" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "id_sitio_luna_marte": { "type": "string", "pattern": "^SL-[0-9]{2}$" },
    "id_sitio_tierra": { "type": "string", "pattern": "^ST-[0-9]{2}$" },
    "cuerpo_id": { "type": "string", "enum": ["tierra", "luna", "marte"] },
    "nota": { "type": "number", "minimum": 0, "maximum": 1 },
    "centro": {
      "type": "object",
      "required": ["lat", "lon"],
      "description": "Grados. lon de -180 a 180, positiva al este (planetocéntrica en la Luna y Marte).",
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "healpix": {
      "type": "object",
      "required": ["esquema", "nivel"],
      "properties": {
        "esquema": { "type": "string", "enum": ["nested"] },
        "nivel": { "type": "integer", "minimum": 0, "maximum": 29, "description": "order; nside = 2^nivel. No definitivo (I-38)." }
      }
    },
    "cuerpo": {
      "type": "object",
      "required": ["nombre", "radio_m", "gravedad_ms2", "presion_superficie_pa", "atmosfera", "radiacion"],
      "description": "Lo que la Tierra no reproduce (principio 9). Se muestra en la ficha, no entra a la nota.",
      "properties": {
        "nombre": { "type": "string" },
        "radio_m": { "type": "number", "exclusiveMinimum": 0 },
        "gravedad_ms2": { "type": "number", "exclusiveMinimum": 0 },
        "presion_superficie_pa": { "type": "number", "minimum": 0 },
        "atmosfera": { "type": "string" },
        "radiacion": { "type": "string" },
        "fuente": { "type": "string" }
      }
    },
    "variable": {
      "type": "object",
      "required": ["id", "codigo", "nombre", "unidad", "aplica_a"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "codigo": { "type": "string", "pattern": "^N[0-9]+$", "description": "Código en ADR-008 §3.1." },
        "nombre": { "type": "string" },
        "unidad": { "type": "string" },
        "aplica_a": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["luna", "marte"] } },
        "descripcion": { "type": "string" }
      }
    },
    "marca": {
      "type": "object",
      "required": ["id", "nombre", "tipo"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nombre": { "type": "string" },
        "tipo": { "type": "string", "enum": ["filtro", "proceso", "sin_dato"] }
      }
    },
    "perfil": {
      "type": "object",
      "required": ["id", "nombre", "contra", "variables"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nombre": { "type": "string" },
        "contra": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["luna", "marte"] } },
        "variables": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "descripcion": { "type": "string" }
      }
    },
    "sitio_objetivo": {
      "type": "object",
      "required": ["id", "nombre", "cuerpo", "centro"],
      "properties": {
        "id": { "$ref": "#/$defs/id_sitio_luna_marte" },
        "nombre": { "type": "string" },
        "cuerpo": { "type": "string", "enum": ["luna", "marte"] },
        "centro": { "$ref": "#/$defs/centro" },
        "descripcion": { "type": "string" }
      }
    },
    "analogo_conocido": {
      "type": "object",
      "required": ["id", "nombre", "centro"],
      "properties": {
        "id": { "$ref": "#/$defs/id_sitio_tierra" },
        "nombre": { "type": "string" },
        "centro": { "$ref": "#/$defs/centro" },
        "analogo_de": { "type": "array", "items": { "type": "string", "enum": ["luna", "marte"] } }
      }
    },
    "resultado_resumen": {
      "type": "object",
      "required": ["perfil", "sitio", "archivo", "n_candidatos", "mejor"],
      "properties": {
        "perfil": { "$ref": "#/$defs/id" },
        "sitio": { "$ref": "#/$defs/id_sitio_luna_marte" },
        "archivo": { "type": "string", "description": "Ruta relativa a metrics.json." },
        "n_candidatos": { "type": "integer", "minimum": 0 },
        "mejor": {
          "type": ["object", "null"],
          "required": ["nota", "centro"],
          "properties": {
            "nota": { "$ref": "#/$defs/nota" },
            "centro": { "$ref": "#/$defs/centro" },
            "region": { "type": ["string", "null"] }
          }
        }
      }
    },
    "fuente": {
      "type": "object",
      "required": ["id", "nombre", "version", "url"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nombre": { "type": "string" },
        "version": { "type": "string" },
        "url": { "type": "string", "pattern": "^https://" },
        "licencia": { "type": "string" }
      }
    }
  }
}
