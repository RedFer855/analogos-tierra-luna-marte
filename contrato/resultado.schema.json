{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resultado.schema.json",
  "title": "resultados/<perfil>/<SL-NN>.json: candidatos de la Tierra para un sitio y un perfil (ADR-010)",
  "description": "Un archivo por par perfil-sitio, listado en metrics.json > resultados. Campos desconocidos se ignoran.",
  "type": "object",
  "required": ["version_contrato", "es_ejemplo", "perfil", "sitio", "healpix", "objetivo", "parametros", "candidatos"],
  "properties": {
    "version_contrato": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "es_ejemplo": { "type": "boolean" },
    "perfil": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "sitio": { "type": "string", "pattern": "^SL-[0-9]{2}$" },
    "healpix": {
      "type": "object",
      "required": ["esquema", "nivel"],
      "properties": {
        "esquema": { "type": "string", "enum": ["nested"] },
        "nivel": { "type": "integer", "minimum": 0, "maximum": 29 }
      }
    },
    "objetivo": {
      "type": "object",
      "required": ["variables"],
      "description": "Valores del sitio de la Luna o Marte, en la misma unidad que las celdas.",
      "properties": {
        "variables": { "type": "object", "additionalProperties": { "$ref": "#/$defs/valor" } }
      }
    },
    "parametros": {
      "type": "object",
      "required": ["variables", "filtros"],
      "description": "Con qué se calculó la nota. El visor lo muestra; si vuelve a puntuar (ADR-003), lo usa como punto de partida.",
      "properties": {
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "peso", "tolerancia"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "peso": { "type": "number", "minimum": 0 },
              "tolerancia": { "type": "number", "minimum": 0, "description": "τ en la unidad de la variable (ADR-008 §3.5)." }
            }
          }
        },
        "filtros": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } }
      }
    },
    "candidatos": { "type": "array", "items": { "$ref": "#/$defs/celda" } }
  },
  "$defs": {
    "valor": {
      "type": "object",
      "required": ["valor"],
      "properties": { "valor": { "type": ["number", "null"], "description": "null = sin dato. Nunca 0 en lugar de null." } }
    },
    "celda": {
      "type": "object",
      "required": ["rango", "ipix", "centro", "vertices", "nota", "variables", "cobertura", "marcas", "analogo_conocido", "region"],
      "properties": {
        "rango": { "type": "integer", "minimum": 1, "description": "1 = la más parecida. Los candidatos vienen ordenados." },
        "ipix": { "type": "integer", "minimum": 0, "description": "Índice HEALPix nested al nivel del archivo. Llave única de la celda." },
        "centro": {
          "type": "object",
          "required": ["lat", "lon"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        },
        "vertices": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "description": "Cuatro esquinas [lon, lat] (orden de GeoJSON y de Cartesian3.fromDegreesArray). El visor no necesita una librería de HEALPix.",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          }
        },
        "nota": { "type": "number", "minimum": 0, "maximum": 1, "description": "Nota calibrada S de 0 a 1 (ADR-006). Para porcentaje: × 100." },
        "variables": {
          "type": "object",
          "description": "Una llave por variable del perfil.",
          "additionalProperties": {
            "type": "object",
            "required": ["valor", "nota", "coincide"],
            "properties": {
              "valor": { "type": ["number", "null"] },
              "nota": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "coincide": { "type": ["boolean", "null"], "description": "true si |celda − objetivo| ≤ τ; null si falta el dato." }
            }
          }
        },
        "cobertura": {
          "type": "object",
          "required": ["usadas", "total"],
          "description": "Variables con dato sobre variables del perfil; el visor muestra «usadas/total».",
          "properties": {
            "usadas": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 1 }
          }
        },
        "marcas": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } },
        "analogo_conocido": { "type": ["string", "null"], "pattern": "^ST-[0-9]{2}$" },
        "region": { "type": ["string", "null"] },
        "ficha": {
          "type": "object",
          "description": "Opcional. Datos solo de ficha (temperatura absoluta, hielo, mineral…). Se agrega en 1.x sin romper.",
          "additionalProperties": {
            "type": "object",
            "required": ["valor", "unidad"],
            "properties": {
              "valor": { "type": ["number", "string", "null"] },
              "unidad": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
